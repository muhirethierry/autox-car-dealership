generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  MANAGER
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum VehicleStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid()) @db.VarChar(30)
  email         String    @unique @db.VarChar(254)
  passwordHash  String    @db.VarChar(255)
  firstName     String    @db.VarChar(80)
  lastName      String    @db.VarChar(80)
  phone         String?   @db.VarChar(32)
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  payments      Payment[] @relation("PaymentRecorder")
  activities    AdminActivity[]
  @@index([role, isActive])
}

model Vehicle {
  id             String   @id @db.VarChar(80)
  brand          String   @db.VarChar(80)
  model          String   @db.VarChar(100)
  year           Int
  registration   String?  @unique @db.VarChar(40)
  category       String   @db.VarChar(40)
  transmission   String   @db.VarChar(40)
  fuelType       String   @db.VarChar(40)
  seats          Int
  dailyRate      Decimal  @db.Decimal(12, 2)
  weeklyRate     Decimal  @db.Decimal(12, 2)
  monthlyRate    Decimal  @db.Decimal(12, 2)
  currency       String   @default("RWF") @db.Char(3)
  description    String   @db.Text
  imageUrl       String?  @db.VarChar(2048)
  status         VehicleStatus @default(AVAILABLE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bookings       Booking[]
  maintenance    MaintenanceRecord[]
  @@index([status, category])
  @@index([brand, model])
}

model Booking {
  id             String        @id @default(cuid()) @db.VarChar(30)
  reference      String        @unique @db.VarChar(32)
  customerId     String        @db.VarChar(30)
  vehicleId      String        @db.VarChar(80)
  pickupLocation String        @db.VarChar(200)
  pickupAt       DateTime
  returnAt       DateTime
  dailyRate      Decimal       @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  currency       String        @default("RWF") @db.Char(3)
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  payments       Payment[]
  @@index([vehicleId, status, pickupAt, returnAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id            String        @id @default(cuid()) @db.VarChar(30)
  bookingId     String        @db.VarChar(30)
  recorderId    String?       @db.VarChar(30)
  provider      String        @db.VarChar(40)
  providerRef   String?       @unique @db.VarChar(120)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("RWF") @db.Char(3)
  status        PaymentStatus @default(PENDING)
  verifiedAt    DateTime?
  refundedAt    DateTime?
  receiptRef    String?       @db.VarChar(80)
  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  recorder      User?         @relation("PaymentRecorder", fields: [recorderId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
}

model MaintenanceRecord {
  id             String   @id @default(cuid()) @db.VarChar(30)
  vehicleId      String   @db.VarChar(80)
  description    String   @db.Text
  serviceDate    DateTime
  completedAt    DateTime?
  expense        Decimal? @db.Decimal(12, 2)
  currency       String   @default("RWF") @db.Char(3)
  status         String   @db.VarChar(24)
  createdAt      DateTime @default(now())
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  @@index([vehicleId, serviceDate])
}

model AdminActivity {
  id        String   @id @default(cuid()) @db.VarChar(30)
  actorId   String?  @db.VarChar(30)
  action    String   @db.VarChar(80)
  detail    String   @db.Text
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt])
}
